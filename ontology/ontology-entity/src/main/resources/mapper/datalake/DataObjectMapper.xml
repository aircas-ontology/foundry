<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aircas.ptr.foundry.ontology.entity.repository.mapper.datalake.DataObjectMapper">
    <resultMap id="BaseResultMap" type="com.aircas.ptr.foundry.ontology.entity.model.po.DirectoryItemPO">
        <result column="primaryKey" jdbcType="VARCHAR" property="primaryKey"/>
        <result column="displayName" jdbcType="VARCHAR" property="displayName"/>
    </resultMap>

    <resultMap id="ObjectResultMap" type="java.util.HashMap">

    </resultMap>

    <select id="queryDirectory" resultMap="BaseResultMap">
        select "${primaryKey}" as primaryKey,
               "${titleKey}"   as displayName
        from ${tableName}
    </select>

    <select id="queryAnySQL" resultMap="ObjectResultMap">
        ${query}
    </select>

    <select id="queryTableData" resultType="java.util.HashMap">
        SELECT * FROM ${tableName} ORDER BY id DESC;
    </select>

    <select id="queryTableDataByColumn" resultType="java.util.Map">
        SELECT
        <foreach item="value" index="key" collection="columnNames" separator=", ">
            ${key} AS ${value}
        </foreach>
        FROM ${tableName}
        ORDER BY id DESC;
    </select>


    <update id="updateAnySQL">
        ${updateSql}
    </update>

</mapper>

