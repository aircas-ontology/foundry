<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aircas.ptr.foundry.ontology.repository.mainMapper.OntologyMetaMapper">


    <select id="selectByDisplayName" resultType="java.lang.Integer">
        select
        count(1)
        from ontology_meta
        where display_name = #{displayName}
    </select>


</mapper>