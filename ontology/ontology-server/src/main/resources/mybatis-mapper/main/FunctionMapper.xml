    <select id="selectFunctionViewsByOntologyId" resultMap="OntologyFunctionViewResultMap">
        SELECT
            f.id AS function_id,
            f.api,
            f.description,
            f.status,
            f.object_types,
            p.id AS param_id,
            p.function_id,
            p.parameter_name,
            p.parameter_type,
            p.description AS param_description
        FROM
            function f
        LEFT JOIN
            function_param p ON f.id = p.function_id
        WHERE
            f.object_types = #{ontologyUniqId}
    </select>
