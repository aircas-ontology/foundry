    <select id="selectActionViewByOntologyIdentifier" resultMap="OntologyActionViewResultMap">
        SELECT
            a.id AS action_id,
            a.api,
            a.function_api,
            a.ontology_unique_identifier,
            a.description,
            a.display_name,
            a.status,
            a.handle_type,
            a.ontology_link_group_id,
            t.object_primary_key AS task_object_primary_key,
            t.start_time,
            t.end_time,
            t.corn,
            t.status AS task_status,
            r.object_primary_key AS rule_object_primary_key,
            r.rules,
            r.rule_connect_type,
            r.status AS rule_status,
            m.id AS mapping_in_id,
            m.ontology_action_id,
            m.parameter_name,
            m.property_unique_identifier
        FROM ontology_action a LEFT JOIN action_handle_rule r ON a.id = r.action_id
        LEFT JOIN action_handle_task t ON a.id = t.action_id
        LEFT JOIN ontology_action_mapping_in m ON a.id = m.ontology_action_id
        WHERE a.ontology_unique_identifier = #{ontologyUniqueIdentifier}
