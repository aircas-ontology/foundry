<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aircas.ptr.foundry.ontology.repository.datalakeMapper.DatasourceConnectionMapper">

    <resultMap id="BaseResultMap" type="com.aircas.ptr.foundry.ontology.model.po.DatasourceConnection">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="db_type" property="dbType"/>
        <result column="driver_class" property="driverClass"/>
        <result column="jdbc_url" property="jdbcUrl"/>
        <result column="host" property="host"/>
        <result column="port" property="port"/>
        <result column="db_name" property="dbName"/>
        <result column="schema_name" property="schemaName"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="description" property="description"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, name, db_type, driver_class, jdbc_url, host, port, db_name, schema_name,
        username, password, description, status, create_time, update_time
    </sql>

    <select id="searchByKeyword" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM public.datasource_connection
        WHERE status = 1
        <if test="keyword != null and keyword != ''">
            AND (name LIKE CONCAT('%', #{keyword}, '%') OR db_type LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        ORDER BY update_time DESC
    </select>

</mapper>
