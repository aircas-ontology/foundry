<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aircas.ptr.foundry.ontology.repository.datalakeMapper.TableFieldMappingMapper">

    <resultMap id="BaseResultMap" type="com.aircas.ptr.foundry.ontology.model.po.TableFieldMapping">
        <id column="id" property="id"/>
        <result column="source_table_name" property="sourceTableName"/>
        <result column="source_column_name" property="sourceColumnName"/>
        <result column="target_table_name" property="targetTableName"/>
        <result column="target_column_name" property="targetColumnName"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, source_table_name, source_column_name, target_table_name, target_column_name, create_time
    </sql>

    <select id="selectBySourceAndTarget" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM "${schemaName}"."table_field_mapping"
        WHERE source_table_name = #{sourceTableName}
          AND target_table_name = #{targetTableName}
        LIMIT 1
    </select>

    <select id="selectBySourceTable" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM "${schemaName}"."table_field_mapping"
        WHERE source_table_name = #{sourceTableName}
    </select>

    <select id="selectByTargetTable" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM "${schemaName}"."table_field_mapping"
        WHERE target_table_name = #{targetTableName}
        LIMIT 1
    </select>

    <select id="selectBySourceTableAndColumn" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List"/>
        FROM "${schemaName}"."table_field_mapping"
        WHERE source_table_name = #{sourceTableName}
          AND source_column_name = #{sourceColumnName}
    </select>

    <insert id="insertMapping">
        INSERT INTO "${schemaName}"."table_field_mapping"
        (source_table_name, source_column_name, target_table_name, target_column_name, create_time)
        VALUES (#{mapping.sourceTableName},
                #{mapping.sourceColumnName},
                #{mapping.targetTableName},
                #{mapping.targetColumnName},
                COALESCE(#{mapping.createTime}, NOW()))
    </insert>

</mapper>
