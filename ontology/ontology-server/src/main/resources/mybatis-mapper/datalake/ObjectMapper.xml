<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.aircas.ptr.foundry.ontology.repository.datalakeDao.ObjectMapper">
    <resultMap id="BaseResultMap" type="com.aircas.ptr.foundry.model.po.DirectoryItem">
        <result column="primary_key" jdbcType="VARCHAR" property="primaryKey" />
        <result column="display_name" jdbcType="VARCHAR" property="displayName" />
    </resultMap>

    <select id="queryDirectory" resultMap="BaseResultMap">
        select
          #{primaryKey,jdbcType=VARCHAR},
          #{titleKey,jdbcType=VARCHAR}
        from #{tableName,jdbcType=VARCHAR}
    </select>

</mapper>

