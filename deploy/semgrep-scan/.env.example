# Copy to .env only when overriding these local deployment defaults.
# Image selection: build.ps1 -Image ... or SCAN_IMAGE=... bash build.sh.
# For a later separate startup, export SCAN_IMAGE to that same tag.
SCAN_BIND_ADDRESS=127.0.0.1
SCAN_PORT=18080
# true denies network egress and may disable host port publishing (Docker Engine 29).
# Use true when Java/gateway joins the same Docker network.
SCAN_NETWORK_INTERNAL=false
# SEMGREP_BASE_IMAGE is supplied from base-image.json by the build/start scripts.
# Do not add tokens, business database credentials or runtime Registry configuration.
